# Copy to `.env.local` for local dev. Do NOT commit `.env.local`.
#
# Base URL of the Octo backend API (the Rust octo-server).
#   - Local dev:   http://localhost:8080  (http is accepted only in `next dev`)
#   - Production:  your deployed API origin, e.g. https://octo-api.fly.dev
#                  MUST start with https:// — `pnpm build` will fail otherwise.
#
# IMPORTANT: NEXT_PUBLIC_* variables are inlined at BUILD time by Next.js, not read at
# runtime. Changing this value requires a rebuild/redeploy — editing the env in the hosting
# dashboard alone will not take effect until the next build. On Vercel, set this in the
# project's Environment Variables, then redeploy.
NEXT_PUBLIC_OCTO_API_URL=http://localhost:8080

# Stellar network: "testnet" (default) or "mainnet".
# Controls USDC issuer, explorer URLs, and test-mode banners.
# An unknown value causes the build to fail immediately.
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Optional: endpoint that receives CSP violation reports (report-to / report-uri).
# Must be an absolute http(s) URL. When unset, empty, or invalid, reporting is disabled
# and no reporting directives or Reporting-Endpoints header are emitted.
# CSP_REPORT_ENDPOINT=https://octo-api.fly.dev/csp-report

# Optional: deployment environment used to pick the HSTS policy.
# Values: "production" | "preview" | "staging" | "development".
# When unset, the value is derived from VERCEL_ENV (set automatically on Vercel).
#   - production:  max-age=63072000; includeSubDomains; preload
#   - preview/staging: max-age=300 (no includeSubDomains, no preload)
#   - development: no HSTS header
# Unknown values in a production build fall back to the short (max-age=300) policy.
# OCTO_DEPLOY_ENV=production