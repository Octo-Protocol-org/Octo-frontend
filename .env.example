# Copy to `.env.local` for local dev. Do NOT commit `.env.local`.
#
# Base URL of the Octo backend API (the Rust octo-server).
#   - Local dev:   http://localhost:8080
#   - Production:  your deployed API origin, e.g. https://octo-api.fly.dev
#
# IMPORTANT: NEXT_PUBLIC_* variables are inlined at BUILD time by Next.js, not read at
# runtime. Changing this value requires a rebuild/redeploy — editing the env in the hosting
# dashboard alone will not take effect until the next build. On Vercel, set this in the
# project's Environment Variables, then redeploy.
NEXT_PUBLIC_OCTO_API_URL=http://localhost:8080
